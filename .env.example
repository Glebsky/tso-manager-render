# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME="TSO Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=daily,sentry,sentry_logs
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tso_manager
DB_USERNAME=tso_admin
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Cache, Session, Queue & Storage
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Redis & Memcached
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Mail Configuration
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3 Storage (Optional)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Pusher / WebSockets & Frontend Vite
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -----------------------------------------------------------------------------
# TSO Game Engine & Scheduler
# -----------------------------------------------------------------------------
TSO_SCHEDULER_MODE=queue
TSO_STALE_TASK_TIMEOUT=10
TSO_SSL_VERIFY=true
TSO_HTTP_TIMEOUT=30
TSO_SESSION_TTL=300
TSO_SESSION_LOCK_WAIT=20

# -----------------------------------------------------------------------------
# Market Analytics
# -----------------------------------------------------------------------------
MARKET_DEFAULT_SERVER_ID=ru
MARKET_OFFER_LIFETIME_HOURS=6
MARKET_CACHE_STRATEGY=individual

# -----------------------------------------------------------------------------
# Observability & Monitoring (Sentry, Pulse, Telescope)
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_PROJECT_TAG="${APP_NAME}"
SENTRY_ENABLE_LOGS=true
SENTRY_LOG_LEVEL=warning
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

PULSE_ENABLED=true
TELESCOPE_ENABLED=true
