# =====================================================================
# supercronic внутри Render-контейнера.
#
# Что изменено: было "* * * * *" (каждую минуту).
# На 0.1 CPU каждый запуск schedule:run - это полный bootstrap Laravel,
# то есть 1-2 секунды CPU, отобранные у HTTP-запросов. Раз в 5 минут
# достаточно: все задачи в Console/Kernel.php переведены на
# everyFiveMinutes(), а границы :00/:05/:10 совпадают с запусками cron.
#
# -d memory_limit=256M: php.ini урезан до 128M ради веб-воркеров,
# но планировщику и queue worker'у нужен запас.
#
# ЕСЛИ НУЖНА ПОМИНУТНАЯ ТОЧНОСТЬ задач - верните "* * * * *" здесь
# И одновременно everyMinute() в app/Console/Kernel.php.
# На Free-плане это заметно ухудшит время отклика сайта.
# =====================================================================
* * * * * cd /var/www/html && php -d memory_limit=256M artisan schedule:run --no-interaction
